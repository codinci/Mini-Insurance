# Copy to .env (gitignored) and fill in real values. Never commit .env.

# PostgreSQL (one server, one database per service)
POSTGRES_USER=mini
POSTGRES_PASSWORD=change-me

# JWT (HMAC signing key; must be at least 32 bytes)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRATION=86400000

# AES-GCM key for quote rating inputs, Base64 of 16/24/32 random bytes
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# SeaweedFS (S3-compatible, local only). The S3 gateway enforces these credentials.
SEAWEEDFS_ACCESS_KEY=change-me-access-key
SEAWEEDFS_SECRET_KEY=change-me-secret-key

# S3 client settings for the host (outside Docker). Inside Compose the endpoint is set per service.
AWS_ACCESS_KEY_ID=change-me-access-key
AWS_SECRET_ACCESS_KEY=change-me-secret-key
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:8333
S3_QUOTES_BUCKET=quotes
S3_CLAIMS_BUCKET=claims
S3_PATH_STYLE_ACCESS=true
